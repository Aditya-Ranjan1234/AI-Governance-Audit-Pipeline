KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
POSTGRES_DSN=postgresql://governance:governance@postgres:5432/governance
RISK_MODEL_MIN_SAMPLES=32
RISK_MODEL_RETRAIN_EVERY=25

# Optional investigator + evidence reviewer (Compose profile: agents).
# Select a tool-use-capable Bedrock model or inference-profile ID available to your account.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
INVESTIGATOR_POSTGRES_DSN=postgresql://governance:governance@postgres:5432/governance
INVESTIGATOR_RULE_IDS=GOV-002,GOV-003,GOV-004,GOV-006,GOV-011,GOV-012
INVESTIGATOR_POLL_SECONDS=5
INVESTIGATOR_MAX_STEPS=6
INVESTIGATOR_MAX_ATTEMPTS=3
INVESTIGATOR_TIMEOUT_SECONDS=120
INVESTIGATOR_MAX_TOKENS=1500
INVESTIGATOR_REVISIONS_ENABLED=true
# Separate reviewer credentials/model; Compose defaults to the local development DB and BEDROCK_MODEL_ID.
REVIEWER_POSTGRES_DSN=postgresql://governance:governance@postgres:5432/governance
REVIEWER_MODEL_ID=
REVIEWER_RULE_IDS=GOV-002,GOV-003,GOV-004,GOV-006,GOV-011,GOV-012
REVIEWER_POLL_SECONDS=5
REVIEWER_MAX_STEPS=6
REVIEWER_MAX_ATTEMPTS=3
REVIEWER_TIMEOUT_SECONDS=120
REVIEWER_MAX_TOKENS=3000
